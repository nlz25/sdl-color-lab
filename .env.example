# Copy this template to .env in the same directory, fill in your settings, and restart the service after changes.
OPENAI_API_KEY=
# Use a model ID available through your API endpoint. The page displays and locks it for each experiment.
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: set a custom experiment directory. Relative paths are resolved from the project root.
# COLOR_MIXING_DATA_DIR=runtime/experiments
